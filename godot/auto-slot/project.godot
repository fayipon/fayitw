; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="自走SLOT"
config/description="暗黑童話風的小紅帽手機老虎機：上方月夜森林裡小紅帽自走斬狼人、中間 1024 路連鎖消除 SLOT（金鑰匙 BONUS 進 Free Spins）、下方投注區。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.031, 0.035, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Sfx="*res://scripts/sfx.gd"
Music="*res://scripts/music.gd"

[display]

window/size/viewport_width=430
window/size/viewport_height=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/dpi/allow_hidpi=true


[importer_defaults]

texture={
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.043, 0.031, 0.035, 1)
